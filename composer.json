{
    "name": "opengeocoding/opengeocoding-provider",
    "type": "library",
    "description": "Geocoder OpenGeocoding adapter",
    "keywords": [
        "geocoder",
        "geocoding",
        "reverse geocoding",
        "openstreetmap",
        "opengeocoding"
    ],
    "homepage": "https://opengeocoding.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Théo Mathieu",
            "homepage": "https://github.com/Mokto"
        }
    ],
    "require": {
        "php": "^8.0",
        "geocoder-php/common-http": "^4.6",
        "willdurand/geocoder": "^4.0|^5.0"
    },
    "provide": {
        "geocoder-php/provider-implementation": "1.0"
    },
    "require-dev": {
        "geocoder-php/provider-integration-tests": "^1.6.3",
        "php-http/message": "^1.0",
        "phpunit/phpunit": "^9.6.11",
        "php-cs-fixer/shim": "^3.22",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Geocoder\\Provider\\OpenGeocoding\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "cs": "vendor/bin/php-cs-fixer fix -v --dry-run",
        "cs:fix": "vendor/bin/php-cs-fixer fix -v",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
